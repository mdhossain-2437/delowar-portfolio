# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname

# ── Session ─────────────────────────────────────────────────────────────────
# Required in production. Use a long random string (e.g. openssl rand -hex 32).
SESSION_SECRET=

# ── Admin account ───────────────────────────────────────────────────────────
# Password for the seeded admin user. Required to create the admin account.
ADMIN_PASSWORD=

# ── Email / contact form ─────────────────────────────────────────────────────
CONTACT_INBOX_EMAIL=you@example.com
MAIL_FROM=Your Name <portfolio@your-domain.dev>
RESEND_API_KEY=

# ── Firebase (admin SDK — only needed for contact dashboard) ─────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_ADMIN_EMAILS=

# ── Firebase (client SDK — exposed via Vite) ─────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── GitHub OAuth (optional) ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ── Miscellaneous ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:5000
